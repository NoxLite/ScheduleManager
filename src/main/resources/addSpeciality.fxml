<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<AnchorPane minHeight="130" minWidth="330" prefHeight="130.0" prefWidth="330.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mygroup.Controllers.AddSpecialityController">
   <children>
      <GridPane prefHeight="107.0" prefWidth="581.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <columnConstraints>
          <ColumnConstraints hgrow="ALWAYS" maxWidth="140.0" minWidth="0.0" prefWidth="80.0" />
          <ColumnConstraints hgrow="ALWAYS" maxWidth="249.0" minWidth="0.0" prefWidth="210.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="0.0" prefHeight="30.0" vgrow="ALWAYS" />
          <RowConstraints minHeight="0.0" prefHeight="30.0" vgrow="ALWAYS" />
        </rowConstraints>
         <children>
            <Label prefHeight="17.0" prefWidth="136.0" text="Название" />
            <TextField fx:id="specialityField" GridPane.columnIndex="1" />
            <VBox alignment="CENTER_RIGHT" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Button fx:id="addButton" mnemonicParsing="false" text="Добавить">
                          <graphic>
                           <FontIcon iconColor="green" iconLiteral="fas-plus" />
                          </graphic>
                  </Button>
               </children>
            </VBox>

         </children>
      </GridPane>
   </children>
   <opaqueInsets>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </opaqueInsets>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
