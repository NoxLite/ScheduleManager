<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mygroup.Controllers.ViewTeacherController">
    <children>
        <GridPane layoutX="13.0" layoutY="10.0" prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="3.0" AnchorPane.rightAnchor="-3.0" AnchorPane.topAnchor="0.0">

            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" prefWidth="100.0" />
            </columnConstraints>

            <rowConstraints>
                <RowConstraints maxHeight="60.0" minHeight="0.0" prefHeight="55.0" vgrow="ALWAYS" />
                <RowConstraints minHeight="10.0" prefHeight="291.0" vgrow="ALWAYS" />
                <RowConstraints maxHeight="60.0" minHeight="10.0" prefHeight="55.0" vgrow="ALWAYS" />
            </rowConstraints>
            <children>
                <Button fx:id="addButton" mnemonicParsing="false" text="Добавить преподавателя">
                    <graphic>
                        <FontIcon iconColor="green" iconLiteral="fas-plus" />
                    </graphic>
                </Button>
                <TableView fx:id="specialityTable" prefHeight="320.0" prefWidth="580.0" GridPane.rowIndex="1">
                    <columns>
                        <TableColumn fx:id="columnName" prefWidth="193.0" text="Фамилия" />
                  <TableColumn prefWidth="193.0" text="Имя" />
                  <TableColumn prefWidth="193.0" text="Отчество" />
                    </columns>
                </TableView>
                <Button fx:id="deleteButton" mnemonicParsing="false" text="Удалить" GridPane.rowIndex="2"> <graphic>
                    <FontIcon iconColor="red" iconLiteral="fas-minus" />
                </graphic> </Button>
            </children>

        </GridPane>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</AnchorPane>
