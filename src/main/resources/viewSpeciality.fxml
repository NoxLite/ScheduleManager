<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mygroup.Controllers.ViewSpecialityController">
    <children>
        <GridPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" prefWidth="100.0" />
            </columnConstraints>

            <rowConstraints>
            <RowConstraints maxHeight="578.0" minHeight="0.0" prefHeight="50.0" vgrow="ALWAYS" />
                <RowConstraints maxHeight="600.0" minHeight="10.0" prefHeight="513.0" vgrow="ALWAYS" />
            <RowConstraints maxHeight="600.0" minHeight="10.0" prefHeight="50.0" vgrow="ALWAYS" />
            </rowConstraints>
         <children>
            <Button fx:id="addButton" mnemonicParsing="false" text="Добавить специальность">
                <graphic>
                    <FontIcon iconColor="green" iconLiteral="fas-plus" />
                </graphic>
            </Button>
            <TableView fx:id="specialityTable" prefHeight="200.0" prefWidth="200.0" GridPane.rowIndex="1">
               <columns>
                  <TableColumn fx:id="columnCourse" prefWidth="75.0" text="Курс" />
                  <TableColumn fx:id="columnName" prefWidth="270.0" text="Направление" />
                  <TableColumn prefWidth="85.0" text="Группа" />
               </columns>
            </TableView>
             <Button mnemonicParsing="false" text="Удалить" GridPane.rowIndex="2" fx:id="deleteButton"> <graphic>
                 <FontIcon iconColor="red" iconLiteral="fas-minus" />
             </graphic> </Button>
         </children>

        </GridPane>
    </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
