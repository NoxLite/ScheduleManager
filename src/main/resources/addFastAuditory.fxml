<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.*?>

<AnchorPane minHeight="200.0" minWidth="400.0" prefHeight="150.0" prefWidth="330.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mygroup.controllers.AddFastAuditoryController">
    <children>
        <GridPane prefHeight="107.0" prefWidth="581.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" maxWidth="140.0" minWidth="0.0" prefWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" maxWidth="249.0" minWidth="0.0" prefWidth="151.0" />
            <ColumnConstraints hgrow="ALWAYS" maxWidth="249.0" minWidth="10.0" prefWidth="90.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="0.0" prefHeight="30.0" vgrow="ALWAYS" />
                <RowConstraints minHeight="0.0" prefHeight="30.0" vgrow="ALWAYS" />
            </rowConstraints>
            <children>
                <VBox alignment="CENTER" prefHeight="65.0" prefWidth="255.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Label contentDisplay="TOP" text="Пример аудитории" />
                  <Label fx:id="exampleLabel" text="п316а">
                     <font>
                        <Font size="36.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </Label>
               </children></VBox>
            <HBox alignment="CENTER_RIGHT" GridPane.columnIndex="2" GridPane.rowIndex="1">
               <children>
                   <Button fx:id="addButton" mnemonicParsing="false" text="Добавить">
                       <graphic>
                           <FontIcon iconColor="green" iconLiteral="fas-plus" />
                       </graphic>
                   </Button>
               </children>
            </HBox>
            <TextField fx:id="beforeTextField" promptText="Впереди">
               <GridPane.margin>
                  <Insets left="10.0" right="10.0" />
               </GridPane.margin>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets></TextField>
            <VBox alignment="CENTER_LEFT" GridPane.columnIndex="1">
               <children>
                  <TextField fx:id="startFieldNumber" promptText="От" />
                  <TextField fx:id="endNumberField" promptText="До">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </TextField>
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </VBox>
            <TextField fx:id="afterTextField" promptText="После" GridPane.columnIndex="2">
               <GridPane.margin>
                  <Insets left="10.0" right="10.0" />
               </GridPane.margin>
            </TextField>
            </children>
        </GridPane>
    </children>
    <opaqueInsets>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </opaqueInsets>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</AnchorPane>
