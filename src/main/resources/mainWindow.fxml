<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <children>

      <HBox alignment="CENTER" cache="true" prefHeight="600.0" prefWidth="800.0" spacing="20.0"
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
         </padding>
         <Button contentDisplay="TOP" maxHeight="-Infinity" mnemonicParsing="false" text="Специальности"
                 fx:id="specialityButton">
            <graphic>
               <FontIcon iconLiteral="mdi-format-list-bulleted" iconSize="64"/>
            </graphic>
         </Button>
         <Button contentDisplay="TOP" mnemonicParsing="false" prefHeight="93.0" prefWidth="101.0"
                 text="Сотрудники">
            <graphic>
               <FontIcon iconLiteral="mdi-account-multiple" iconSize="64"/>
            </graphic>
         </Button>
         <Button contentDisplay="TOP" mnemonicParsing="false" prefHeight="93.0" prefWidth="101.0" text="Группы">
            <graphic>
               <FontIcon iconLiteral="mdi-school" iconSize="64"/>
            </graphic>
         </Button>
         <Button contentDisplay="TOP" mnemonicParsing="false" prefHeight="93.0" prefWidth="101.0" text="Предметы">
            <graphic>
               <FontIcon iconLiteral="mdi-book-open-variant" iconSize="64"/>
            </graphic>
         </Button>
         <Button contentDisplay="TOP" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false"
                 prefHeight="96.0" prefWidth="101.0" text="Расписание">
            <graphic>
               <FontIcon iconLiteral="mdi-clock" iconSize="64" text=""/>
            </graphic>
         </Button>
      </HBox>
         </children>

</AnchorPane>
